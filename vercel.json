{
  "version": 2,
  "buildCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "NODE_ENV": "PRODUCTION"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "timeout": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
